; Engine configuration file.
; Shattered Orbit - Godot 4.7.1
config_version=5

[application]
config/name="Shattered Orbit"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/main_scene="res://scenes/bootstrap/bootstrap.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
common/physics_ticks_per_second=60

[input]
thrust_forward={"deadzone": 0.15, "events": []}
thrust_reverse={"deadzone": 0.15, "events": []}
strafe_left={"deadzone": 0.15, "events": []}
strafe_right={"deadzone": 0.15, "events": []}
strafe_up={"deadzone": 0.15, "events": []}
strafe_down={"deadzone": 0.15, "events": []}
roll_left={"deadzone": 0.15, "events": []}
roll_right={"deadzone": 0.15, "events": []}
boost={"deadzone": 0.15, "events": []}
fire_primary={"deadzone": 0.15, "events": []}
fire_secondary={"deadzone": 0.15, "events": []}
toggle_flight_mode={"deadzone": 0.15, "events": []}
